# Generated by OpenAI Codex on 2026-11-01. Requires verified auth release and TLS.
limit_req_zone $binary_remote_addr zone=cats_auth_rate:1m rate=30r/m;
limit_req_zone $binary_remote_addr zone=cats_api_rate:5m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=cats_connections:1m;
server {
    listen 80;
    server_name cats.tufts.pro;
    location ^~ /.well-known/acme-challenge/ { root /var/www/cats-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name cats.tufts.pro;
    ssl_certificate /etc/letsencrypt/live/cats.tufts.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cats.tufts.pro/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 2m;
    limit_req_status 429;
    limit_conn cats_connections 100;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    location /api/auth/ {
        access_log off;
        limit_req zone=cats_auth_rate burst=30 nodelay;
        proxy_pass http://127.0.0.1:18082;
    }
    location /api/ {
        limit_req zone=cats_api_rate burst=30 nodelay;
        proxy_pass http://127.0.0.1:18082;
    }
    location / { proxy_pass http://127.0.0.1:18082; }
}
