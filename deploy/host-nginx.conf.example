# Generated by OpenAI Codex on 2026-11-01.
# Administrator enables only after DNS, TLS, authentication, and backups are ready.
# Keep existing host Nginx sites unchanged. Certificate must already exist.
server {
    listen 80;
    server_name cats.tufts.pro;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name cats.tufts.pro;
    ssl_certificate /etc/letsencrypt/live/cats.tufts.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cats.tufts.pro/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:18082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
