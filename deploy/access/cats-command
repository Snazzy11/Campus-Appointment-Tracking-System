import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import syslog


def parse_command(args):
    if args in (['upload'], ['status']):
        return args[0], None
    if len(args) == 2 and args[0] == 'deploy' and re.fullmatch(r'[a-z0-9][a-z0-9_.-]{0,63}', args[1]):
        return 'deploy', args[1]
    raise ValueError('Allowed: upload; deploy RELEASE; status')


def run_as_app(args, tag=None, images=None, **kwargs):
    env = ['HOME=/home/catsdeploy', 'USER=catsdeploy', 'LOGNAME=catsdeploy',
           'PATH=/usr/local/bin:/usr/bin:/bin']
    if tag:
        env.append('CATS_TAG='+tag)
    if images:
        env.extend([f'API_IMAGE={images["api"]}', f'WEB_IMAGE={images["web"]}'])
    return subprocess.run(['/usr/sbin/runuser', '-u', 'catsdeploy', '--', '/usr/bin/env', '-i', *env, *args], check=True, **kwargs)


def main():
    action, tag = parse_command(sys.argv[1:])
    if os.getuid() != 0:
        sys.exit('Use the forced SSH command')
    if action == 'status':
        run_as_app(['/usr/bin/docker', '--context', 'rootless', 'ps', '--filter', 'label=com.docker.compose.project=cats-production', '--format', '{{.Names}} {{.Status}} {{.Ports}}'], timeout=30)
        return
    with open('/var/lib/cats-control/deploy.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit('Another CATS upload/deployment is active')
        syslog.openlog('cats-deploy')
        syslog.syslog(f"actor={os.environ.get('SUDO_USER', 'root')} action={action} release={tag}")
        docker = ['/usr/bin/docker', '--context', 'rootless']
        if action == 'upload':
            run_as_app(['/usr/local/libexec/cats-load'], timeout=1000)
        elif action == 'status':
            run_as_app([*docker, 'ps', '--filter', 'label=com.docker.compose.project=cats-production', '--format', '{{.Names}} {{.Status}} {{.Ports}}'], timeout=30)
        else:
            # Only API/web are teammate-replaceable. DB release stays admin-pinned.
            images = {}
            for service in ('api', 'web'):
                result = run_as_app([*docker, 'image', 'inspect', f'cats-{service}:{tag}'], capture_output=True, text=True, timeout=30)
                info = json.loads(result.stdout)[0]
                images[service] = info['Id']
                if info['Architecture'] != 'arm64':
                    sys.exit(f'{service} image must be ARM64')
            subprocess.run(['/usr/local/sbin/cats-backup'], check=True, timeout=300)
            compose = [*docker, 'compose', '--env-file', '/etc/cats/production.env', '-p', 'cats-production', '-f', '/etc/cats/compose.yaml', '-f', '/etc/cats/compose.prod.yaml']
            prior = json.loads(Path('/var/lib/cats-control/release.json').read_text())
            try:
                run_as_app([*compose, 'up', '-d', '--wait', '--wait-timeout', '120', '--no-build', '--pull', 'never', '--no-deps', 'api', 'web'], tag=tag, images=images, timeout=180)
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
                run_as_app([*compose, 'up', '-d', '--wait', '--wait-timeout', '120', '--no-build', '--pull', 'never', '--no-deps', 'api', 'web'], tag=prior['tag'], images=prior['images'], timeout=180)
                sys.exit('Deployment failed; previous application images restored')
            Path('/var/lib/cats-control/release.json').write_text(json.dumps({'tag': tag, 'images': images})+'\n')
            print('Deployed', tag)

if __name__ == '__main__':
