name = 'cats-'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')+'.dump'
limit = 512*1024*1024
command = ['/usr/sbin/runuser','-u','catsdeploy','--','/usr/bin/env','-i',
           'HOME=/home/catsdeploy','PATH=/usr/bin:/bin','docker','--context','rootless',
           'exec','cats-production-db-1','pg_dump','-U','postgres','-d','cats','-Fc']
with tempfile.TemporaryFile(dir=root) as dump:
    with subprocess.Popen(command, stdout=subprocess.PIPE) as process:
        try:
            size=0
            while chunk := process.stdout.read(65536):
                size += len(chunk)
                if size > limit:
                    raise RuntimeError('Backup exceeds 512 MiB cap; increase capacity deliberately')
                dump.write(chunk)
            if process.wait(timeout=30) != 0 or size < 5:
                raise RuntimeError('pg_dump failed')
