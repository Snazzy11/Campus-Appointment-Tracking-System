[Unit]
Description=CATS PostgreSQL backup to private S3
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cats-backup
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cats-backups /run/lock
PrivateTmp=true
