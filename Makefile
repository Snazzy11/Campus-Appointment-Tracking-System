
# Env variable to make outputs prettier
export FORCE_COLOR := 1

# Mark checks as fake targets
.PHONY: help setup setup-frontend setup-backend setup-hooks application-up web-up build-web backend-up backend-down api-up db-up health status logs test-api lint format format-check typecheck validate validate-backend validate-frontend frontend-lint frontend-format frontend-format-check frontend-typecheck

# Running `make` with no target prints the help below.
.DEFAULT_GOAL := help

##@ Help

# To document a target, add `## description` after it on the same line.
# To start a new group in the help output, add a `##@ Group name` line.
help: ## Show this help message
	@awk 'BEGIN {FS = ":.*## "} \
		/^##@/ {printf "\n\033[1m%s\033[0m\n", substr($$0, 5)} \
		/^[a-zA-Z0-9_-]+:.*## / {printf "  \033[36m%-24s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

##@ Setup

setup: setup-hooks setup-backend setup-frontend ## Install everything and set up git hooks
setup-frontend: ## Install frontend packages from the lockfile
	@echo "downloading dependencies for the frontend from lockfiles"
	pnpm --dir front_end install --frozen-lockfile

setup-backend: ## Install backend packages from the lockfile
	@echo "syncing dependenices for the backend from lockfiles "
	uv sync --locked

setup-hooks: ## Use the repo's git hooks (.githooks/)
	@echo "settings up git hooks"
	git config core.hooksPath .githooks

##@ Run

# Generated by OpenAI Codex on 2026-11-01.
DEV_COMPOSE = docker compose -p cats-dev -f compose.yaml -f compose.build.yaml -f compose.dev.yaml
TEST_COMPOSE = docker compose -p cats-test -f compose.yaml -f compose.build.yaml
PROD_ENV ?= /etc/cats/production.env
PROD_COMPOSE = docker --context rootless compose --env-file $(PROD_ENV) -p cats-production -f /etc/cats/compose.yaml -f /etc/cats/compose.prod.yaml
CATS_TAG ?= local
export CATS_TAG

.PHONY: dev dev-down stack-test stack-down stack-check release-build release-save server-up server-status server-backup

dev: db-up ## Start local DB plus Expo and FastAPI reload; Ctrl-C stops reload processes
	python3 scripts/dev.py

dev-down: ## Stop the local development DB, retaining its volume
	$(DEV_COMPOSE) down

application-up: dev ## Alias for the local development workflow

web-up: ## Start Expo web with the local /api backend
	pnpm --dir front_end web

build-web: ## Export web using same-origin /api requests
	EXPO_PUBLIC_API_URL=/api pnpm --dir front_end build

api-up: ## Run FastAPI with reload against the local development DB
	DB_PASSWORD=$${DB_PASSWORD:-cats-devonly} DB_PORT=$${CATS_DB_PORT:-5434} uv run uvicorn api.main:app --app-dir back_end/app --reload --host 127.0.0.1 --port 8000

db-up: ## Build and start only the local development database on localhost:5434
	$(DEV_COMPOSE) up --build -d --wait db

stack-test: ## Build and start the complete stack at http://localhost:18082
	$(TEST_COMPOSE) up --build -d --wait
	$(MAKE) stack-check

stack-check: ## Verify frontend, API routing, and PostGIS-backed locations
	curl --fail --show-error --max-time 10 http://127.0.0.1:$${CATS_PORT:-18082}/ -o /dev/null
	curl --fail --show-error --max-time 10 http://127.0.0.1:$${CATS_PORT:-18082}/api/health
	curl --fail --show-error --max-time 10 http://127.0.0.1:$${CATS_PORT:-18082}/api/locations

stack-down: ## Stop the complete local stack, retaining its database
	$(TEST_COMPOSE) down

backend-up: stack-test ## Compatibility alias: start the complete container stack
backend-down: stack-down ## Compatibility alias: stop the container stack

release-build: ## Build server ARM64 images locally (set CATS_TAG to a release ID)
	DOCKER_DEFAULT_PLATFORM=linux/arm64 $(TEST_COMPOSE) build

release-save: ## Save built images to ignored work/cats-images.tar
	mkdir -p work
	docker image save -o work/cats-images.tar cats-api:$(CATS_TAG) cats-web:$(CATS_TAG) cats-db:$(CATS_TAG)

server-up: ## ON SERVER as catsdeploy: start preloaded images using admin-owned config
	$(PROD_COMPOSE) up -d --wait --no-build --pull never

server-status: ## ON SERVER as catsdeploy: inspect CATS containers
	$(PROD_COMPOSE) ps

server-backup: ## ON SERVER as catsdeploy: write a private PostgreSQL dump to backups/
	@umask 077; mkdir -p backups; $(PROD_COMPOSE) exec -T db pg_dump -U postgres -d cats -Fc > backups/cats-$$(date -u +%Y%m%dT%H%M%SZ).dump

##@ Status and debugging
health: ## Check the host-side development API
	curl --fail --show-error --max-time 5 http://127.0.0.1:8000/api/health

status: ## Show the complete local container stack
	$(TEST_COMPOSE) ps

logs: ## Follow complete local container stack logs
	$(TEST_COMPOSE) logs --follow --tail=100

##@ Backend checks

test-api: ## Run backend API tests
	@echo "runnning api tests..."
	PYTHONPATH=back_end/app uv run pytest back_end/app/api/test_api.py -v

lint: ## Run backend linter (ruff)
	@echo "Running linter checks"
	uv run ruff check ./back_end

format: ## Run backend formatter (ruff)
	@echo "Running automatic formatting"
	uv run ruff format ./back_end

format-check: ## Run backend formatter with only checks
	@echo "Running formatter without auto-fixing"
	uv run ruff format --check ./back_end

typecheck: ## Run backend type checker (pyright)
	@echo "Running type checks"
	uv run pyright

validate-backend: ## Run all backend validations
	@echo "Running backend validations"
	make format-check
	make lint
	make typecheck

##@ Frontend checks

frontend-lint: ## Run frontend linter (ESLint)
	@echo "Running frontend linter checks"
	pnpm --dir front_end lint

frontend-format: ## Run frontend formatter (Prettier)
	@echo "Running frontend automatic formatting"
	pnpm --dir front_end format

frontend-format-check: ## Run frontend formatter with only checks
	@echo "Running frontend formatter without auto-fixing"
	pnpm --dir front_end format:check

frontend-typecheck: ## Run frontend type checker (TypeScript)
	@echo "Running frontend type checks"
	pnpm --dir front_end typecheck

validate-frontend: ## Run all frontend validations
	@echo "Running frontend validations"
	make frontend-format-check
	make frontend-lint
	make frontend-typecheck

##@ All checks

validate: validate-backend validate-frontend ## Run all backend and frontend checks (what CI runs)

.PHONY: deploy
SSH_HOST ?= ubuntu@hacker.tufts.me
SSH_KEY ?=
deploy: ## ADMIN ONLY: upload existing ARM64 images and start server stack
	@test -n "$(SSH_KEY)" || { echo 'Set SSH_KEY to your administrator SSH key path'; exit 1; }
	python3 scripts/deploy.py --key "$(SSH_KEY)" --host "$(SSH_HOST)" --tag "$(CATS_TAG)"
