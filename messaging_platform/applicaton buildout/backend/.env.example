DB_USER=campus_app
DB_PASSWORD=replace_me
DB_NAME=campus_buildout
DB_HOST=127.0.0.1
DB_PORT=5434
COGNITO_DOMAIN=https://your-domain.auth.your-region.amazoncognito.com
COGNITO_CLIENT_ID=your_public_app_client_id
COGNITO_REGION=your-region
COGNITO_USER_POOL_ID=your_user_pool_id
# Legacy browser login callback; Expo uses the app callback allowlist below.
COGNITO_REDIRECT_URI=http://localhost:8000/auth/callback
COGNITO_APP_REDIRECT_URIS=campusmessaging://auth/callback,http://localhost:8081/auth/callback,http://127.0.0.1:8081/auth/callback
FRONTEND_URL=http://localhost:8081
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
COOKIE_SECURE=false

# Optional private S3 photo storage; see deploy/PROFILES.md.
AVATAR_S3_BUCKET=
AWS_REGION=us-east-2

# Stage 2 is opt-in. Keep disabled for the existing non-spatial database.
GEO_DATA_ENABLED=false
# API: use a SELECT-only credential. Operator migrations/imports use a separate explicit URL.
GEO_DATABASE_URL=

# Stage 4: requires explicit geo003 migration and operator build-graph.
GEO_ROUTING_ENABLED=false
GEO_WALK_SPEED_MPS=1.3
GEO_STAIRS_FACTOR=2
GEO_ROUGH_FACTOR=1.4
GEO_SLOPE_FACTOR=4

# Stage 5: opt-in reports, independent least-privilege spatial writer.
GEO_REPORTS_ENABLED=false
GEO_REPORT_DATABASE_URL=
