# Copy to deploy/ec2.env; keep it private and outside Git.
APP_ORIGIN=https://messaging.tufts.pro
APP_PORT=18080
# Resource budgets: leave capacity for existing applications. Adjust after measuring.
API_MEMORY=384m
WEB_MEMORY=128m
DB_MEMORY=512m
DB_USER=campus_app
DB_PASSWORD=replace_with_a_long_random_password
DB_NAME=campus_messaging
COGNITO_DOMAIN=https://your-domain.auth.your-region.amazoncognito.com
COGNITO_CLIENT_ID=your_public_app_client_id
COGNITO_REGION=your-region
COGNITO_USER_POOL_ID=your_user_pool_id

# Explicit HTTPS deployment override; local Compose defaults to false.
COOKIE_SECURE=true

# Optional private S3 photo storage; see deploy/PROFILES.md.
AVATAR_S3_BUCKET=
AWS_REGION=us-east-2
