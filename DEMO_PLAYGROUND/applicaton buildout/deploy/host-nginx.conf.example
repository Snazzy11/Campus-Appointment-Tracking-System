# Separate site for the EXISTING host Nginx. Do not replace nginx.conf/default sites.
# Enable only after DNS and TLS certificate files are ready and localhost health passes.
server {
    listen 80;
    server_name messaging.tufts.pro;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/campus-ec2demo-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name messaging.tufts.pro;
    ssl_certificate /etc/letsencrypt/live/messaging.tufts.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/messaging.tufts.pro/privkey.pem;
    client_max_body_size 7m;
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
