{
  "expo": {
    "name": "Campus Messaging",
    "slug": "campus-messaging",
    "version": "1.0.0",
    "scheme": "campusmessaging",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your campus profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location once to choose a starting point for campus walking directions.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.campus.messaging",
      "appleTeamId": "GS266CDYMB"
    },
    "android": {
      "package": "edu.campus.messaging"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
